{
  "name": "dsh-ledger-compact",
  "version": "0.14.4",
  "description": "dsh-plugin: OMP-style ingress shaping plus optional local /fast-compact. Can replace DSH /compact and auto-compaction with a mechanical fold.",
  "license": "MIT",
  "author": "telagod",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/client.js"
    },
    "./ledger": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/ledger.js"
    },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "compaction",
    "context",
    "fast-compact",
    "ingress"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/telagod/dsh-ledger-compact.git"
  },
  "bugs": {
    "url": "https://github.com/telagod/dsh-ledger-compact/issues"
  },
  "homepage": "https://github.com/telagod/dsh-ledger-compact#readme",
  "engines": {
    "node": ">=22"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "files": [
    "lib",
    "bench",
    "cordis.patch.yml",
    "LICENSE",
    "README.md",
    "README.zh.md",
    "locale",
    "icon.svg"
  ],
  "scripts": {
    "test": "node --test lib/ledger.test.js",
    "bench": "node bench/layout-bench.mjs",
    "bench:fidelity": "node bench/fidelity-bench.mjs",
    "bench:audit": "node bench/miss-audit.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-commands": "^0.1.7-rc.1 || ^0.2.0-rc.1",
    "@deepseek-ai/dsh-compaction": "^0.1.7-rc.1 || ^0.2.0-rc.1",
    "@deepseek-ai/dsh-llm": "^0.1.7-rc.1 || ^0.2.0-rc.1",
    "@deepseek-ai/dsh-settings": "^0.1.7-rc.1 || ^0.2.0-rc.1",
    "@deepseek-ai/dsh-token-meter": "^0.1.7-rc.1 || ^0.2.0-rc.1",
    "@deepseek-ai/dsh-tools": "^0.1.7-rc.1 || ^0.2.0-rc.1",
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "icon": "./icon.svg",
  "meta": {
    "title": "Ledger Compact",
    "description": "Ingress shaping plus optional local fast-compact; can replace the built-in /compact and automatic compaction."
  },
  "types": "lib/types/index.d.ts"
}
